GEMINI_API_KEY=

# Supabase project URL (Project Settings -> API -> Project URL), e.g.
# https://xxxxxxxxxxxxxxxx.supabase.co -- NOT a postgresql:// connection
# string; the app talks to it over the Supabase REST client, not raw SQL.
DATABASE_URL=

# Supabase anon/publishable key (Project Settings -> API). Subject to
# whatever Row Level Security policies are on each table.
SUPABASE_ANON_KEY=
